  "resource_changes": [],
  "configuration": {
    "provider_config": {
      "oci": {"name": "oci", "full_name": "registry.terraform.io/oracle/oci",
              "expressions": {"region": {"references": ["var.region"]}}}
    },
    "root_module": {
      "resources": [
        {
          "address": "oci_core_vcn.main", "mode": "managed", "type": "oci_core_vcn", "name": "main",
          "expressions": {"display_name": {"constant_value": "vcn-plan"},
                          "compartment_id": {"references": ["var.compartment_ocid"]}}
        },
        {
          "address": "oci_core_subnet.web", "mode": "managed", "type": "oci_core_subnet", "name": "web",
          "expressions": {"vcn_id": {"references": ["oci_core_vcn.main.id", "oci_core_vcn.main"]},
                          "display_name": {"constant_value": "sn-web"}}
        },
        {
          "address": "oci_core_subnet.app", "mode": "managed", "type": "oci_core_subnet", "name": "app",
          "expressions": {"vcn_id": {"references": ["oci_core_vcn.main.id", "oci_core_vcn.main"]}}
        },
        {
          "address": "oci_core_subnet.data", "mode": "managed", "type": "oci_core_subnet", "name": "data",
          "expressions": {"vcn_id": {"references": ["oci_core_vcn.main.id", "oci_core_vcn.main"]}}
        },
        {
          "address": "oci_core_instance.app", "mode": "managed", "type": "oci_core_instance", "name": "app",
          "count_expression": {"constant_value": 2},
          "expressions": {
            "display_name": {"references": ["count.index"]},
            "create_vnic_details": [
              {"subnet_id": {"references": ["oci_core_subnet.app.id", "oci_core_subnet.app"]},
               "assign_public_ip": {"constant_value": false}}
            ]
          }
        },
        {
          "address": "oci_load_balancer_load_balancer.web", "mode": "managed",
          "type": "oci_load_balancer_load_balancer", "name": "web",
          "expressions": {"subnet_ids": {"references": ["oci_core_subnet.web.id", "oci_core_subnet.web"]}}
        },
        {
          "address": "oci_load_balancer_backend.app", "mode": "managed", "type": "oci_load_balancer_backend",
          "name": "app", "count_expression": {"constant_value": 2},
          "expressions": {
            "load_balancer_id": {"references": ["oci_load_balancer_load_balancer.web.id",
                                                "oci_load_balancer_load_balancer.web"]},
            "ip_address": {"references": ["oci_core_instance.app[count.index].private_ip",
                                          "oci_core_instance.app[count.index]", "oci_core_instance.app",
                                          "count.index"]},
            "port": {"constant_value": 8080}
          }
        },
        {
          "address": "oci_core_internet_gateway.igw", "mode": "managed", "type": "oci_core_internet_gateway",
          "name": "igw",
          "expressions": {"vcn_id": {"references": ["oci_core_vcn.main.id", "oci_core_vcn.main"]}}
        },
        {
          "address": "oci_mysql_mysql_db_system.db", "mode": "managed", "type": "oci_mysql_mysql_db_system",
          "name": "db",
          "expressions": {"subnet_id": {"references": ["data.oci_core_subnets.data.subnets[0].id",
                                                        "data.oci_core_subnets.data"]}}
        }
      ],
      "module_calls": {
        "storage": {
          "source": "./modules/storage",
          "module": {
            "outputs": {"bucket_name": {"expression": {"references": ["oci_objectstorage_bucket.logs.name",
                                                                       "oci_objectstorage_bucket.logs"]}}},
            "resources": [
              {"address": "oci_objectstorage_bucket.logs", "mode": "managed", "type": "oci_objectstorage_bucket",
               "name": "logs", "expressions": {"name": {"constant_value": "plan-logs"}}}
            ],
            "module_calls": {
              "nested": {
                "source": "./vault",
                "module": {
                  "resources": [
                    {"address": "oci_kms_vault.main", "mode": "managed", "type": "oci_kms_vault", "name": "main",
                     "expressions": {"display_name": {"constant_value": "vault-plan"}}}
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
